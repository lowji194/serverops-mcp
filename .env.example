# ServerOps MCP Configuration Template
# Reference template only. The installer writes /etc/serverops-mcp/serverops.env.
# Never commit real secrets or runtime configuration.

# Server Network Binding
SERVEROPS_BIND_HOST=127.0.0.1
SERVEROPS_PORT=8790
SERVEROPS_PUBLIC_BASE_URL=https://mcp.example.com

# OAuth 2.1 & Security
SERVEROPS_OAUTH_ISSUER=https://mcp.example.com
# The signing key is generated and stored automatically in the private data directory.
# Set this only if you intentionally manage key generation and rotation.
# SERVEROPS_OAUTH_SIGNING_KEY=
SERVEROPS_OWNER_SUBJECT=serverops-owner
# The owner password hash can be set via first-run bootstrap token claim,
# the local CLI (sudo serverops reset-password), or by providing an scrypt hash (salt:derived_hex).
# SERVEROPS_OWNER_PASSWORD_HASH=salt_hex:scrypt_hash_hex


# Optional confidential OAuth client for Gemini integrations that require Client ID/Secret.
# Leave these unset to use public OAuth clients (for example, ChatGPT DCR).
# Create a Web application OAuth client in Google Cloud and use the exact redirect URI
# displayed by your Gemini app. Never commit the real Client Secret.
# SERVEROPS_GEMINI_CLIENT_ID=your-google-cloud-oauth-client-id
# SERVEROPS_GEMINI_CLIENT_SECRET=your-google-cloud-oauth-client-secret
# SERVEROPS_GEMINI_REDIRECT_URI=https://oauth-redirect.googleusercontent.com/r/your-gemini-app-id

# Storage & Runtime Paths
SERVEROPS_DATA_DIR=/var/lib/serverops-mcp
SERVEROPS_BACKUP_DIR=/var/lib/serverops-mcp/backups
SERVEROPS_SECRET_DIR=/etc/serverops-mcp/secrets

# Execution Engine Bounds
SERVEROPS_EXECUTION_CONCURRENCY=4
SERVEROPS_EXECUTION_QUEUE_LIMIT=32
SERVEROPS_EXECUTION_MAX_TIMEOUT_SECONDS=3600
SERVEROPS_EXECUTION_MAX_OUTPUT_BYTES=67108864
SERVEROPS_NETWORK_MAX_RESPONSE_BYTES=67108864
SERVEROPS_NETWORK_ARTIFACT_TTL_SECONDS=86400
